CRYPT_PUBLIC_KEY="024d633d774005d2d84fc8a1df758b512a24877d6ac2983b1ecfb5df53d41e2a99"

# .env

# Node
NODE_ENV=development
TZ=UTC
PORT=3500
HOST=0.0.0.0

# App
LOG_LEVEL=info
