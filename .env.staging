#/---------------------[CRYPT PUBLIC KEY]-----------------------/
#/             public-key encryption for .env files             /
#/   [how it works](https://friendsofadonis.com/docs/crypt)     /
#/--------------------------------------------------------------/
CRYPT_PUBLIC_KEY_STAGING="03ca4c8610be23fa490a9b26ca833e4c8059bce232102b6b605d8f5359f507b26b"

# .env.staging

# Node
NODE_ENV=development
TZ=UTC
PORT=3500
HOST=0.0.0.0

# App
LOG_LEVEL=info
APP_KEY=2xbvu-EZ5g8viOREwy-MLmijeQEklsCB
APP_URL=http://${HOST}:${PORT}

# Database
DB_HOST=host.docker.internal
DB_PORT=3307
DB_USER=testuser
DB_PASSWORD=testpassword
DB_DATABASE=alovy_starterkit_develop
DB_CONNECTION=postgres
DB_DEBUG=true

# API Token
# Définir la durée d'expiration des jetons :
# - En jours : "30 days"
# - En heures : "12 hours"
# - En secondes : "3600"
API_USER_TOKEN_EXPIRATION="1 days"
API_USER_TOKEN_SECRET_LENGTH=128

# Health
# Authentification via Header pour les requêtes API qui souhaite accéder à la route /health
HEALTH_API_KEY_SECRET=toto

# Session
SESSION_DRIVER=memory